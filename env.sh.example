# Copy to ignored env.sh, replace placeholders, and source it on BU SCC.
module load python3/3.12.4
export EC523_PROJECT_DIR="<YOUR_PROJECT_DIR>"
export EC523_STARTER_DIR="<YOUR_STARTER_DIR>/cli"
export PIP_CACHE_DIR="$EC523_PROJECT_DIR/cache/pip"
export TMPDIR="$EC523_PROJECT_DIR/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export XDG_CACHE_HOME="$EC523_PROJECT_DIR/cache/xdg"
export TORCH_HOME="$EC523_PROJECT_DIR/cache/torch"
export HF_HOME="$EC523_PROJECT_DIR/cache/huggingface"
export PYTHONPYCACHEPREFIX="$EC523_PROJECT_DIR/cache/pycache"
export PYTHONUSERBASE="$EC523_PROJECT_DIR/env/user"
mkdir -p "$TMPDIR" "$PIP_CACHE_DIR" "$XDG_CACHE_HOME" "$TORCH_HOME" \
    "$HF_HOME" "$PYTHONPYCACHEPREFIX" "$PYTHONUSERBASE"
source "$EC523_PROJECT_DIR/env/venv/bin/activate"
# Optional development tools from the original SCC environment:
# module load nodejs/20.12.2
# export PATH="$EC523_PROJECT_DIR/tools/node_modules/.bin:$PATH"
