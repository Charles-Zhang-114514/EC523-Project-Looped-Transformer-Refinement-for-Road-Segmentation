#!/bin/bash -l
#$ -N ec523-refiner-dr
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=02:00:00
#$ -j y
#$ -m ea
#$ -o runs/logs/

# Provisional header only. REQUIRED: use train_detail_refiner.py --estimate after passed GPU smoke and override h_rt with its measured budget; supply SMOKE_DIR. Baseline DR-S 60 min / DR-W 25 min; additional costs are measured, never CPU-extrapolated.
source "${SGE_O_WORKDIR:?Submit from the repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
export PYTHONPATH="$PWD:$PWD/src"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
nvidia-smi --query-gpu=name,compute_mode --format=csv
python - <<'PYINFO'
import sys, torch
from importlib.metadata import version
print("Python:",sys.version.split()[0],flush=True)
for name in ("torch","numpy","scipy","Pillow","transformers","safetensors"):
    print(name,version(name),flush=True)
PYINFO
git rev-parse HEAD
python - <<'PYCACHE'
import json
from pathlib import Path
m=json.loads(Path('runs/cache/tta_draft_a1i_s0/manifest.json').read_text())
if m.get('smoke') or not m.get('gates_passed') or m['total_images']!=4191:
    raise SystemExit('A complete regression-passed full cache is required')
PYCACHE
python -u scripts/train_detail_refiner.py --arm "${ARM:?Set ARM=S or W}" --seed "${SEED:?Set SEED=0,1,2}" --smoke-dir "${SMOKE_DIR:?Supply passed wave4 smoke directory}"
