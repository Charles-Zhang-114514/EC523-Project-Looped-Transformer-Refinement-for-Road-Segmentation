#!/bin/bash -l
#$ -N ec523-refiner-v1-diagnostics
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=01:30:00
#$ -m ea
#$ -j y
#$ -o runs/logs/

# Submit from the repository root; create runs/logs first.
# A40 measured inference: (0.076+0.035)*(1669+200)=207.46 s (~3.46 min).
# Val metrics: 3*9 threshold groups + 2 extra K groups = 29 groups;
# 1669*29*0.11/6=887.35 s. Train: 200*5*0.11/6=18.33 s.
# Independent flip/Counts self-check adds 1669*5*0.11/6=152.99 s.
# Geometry: budget 5 group-equivalents per Val image, 1669*5*0.22/6=305.98 s.
# These serial estimates total ~26.2 min; forward/workers overlap in practice.
# Allow 30-60 min for startup, filesystem, geometry variance and 40 triptychs;
# request 90 min. CPU pilot inference times are not extrapolated to the GPU.
# 1 loader + 6 spawn metric/geometry workers + main = 8 slots.
source "${SGE_O_WORKDIR:?Submit from the repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
: "${EC523_DATA_DIR:?Set EC523_DATA_DIR in env.sh}"
: "${EC523_STARTER_DIR:?Set EC523_STARTER_DIR in env.sh}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

python -c 'import torch, numpy, transformers; print("GPU:", torch.cuda.get_device_name(), flush=True); print("Versions:", torch.__version__, numpy.__version__, transformers.__version__, flush=True)'
git rev-parse HEAD
python -u analysis/refiner_diagnostics.py \
    --device cuda --loader-workers 1 --metric-workers 6 \
    --ckpt runs/refiner/v1/checkpoints/last.pt \
    --out-dir results/refiner/v1_diagnostics \
    --vis-dir runs/refiner/v1_diagnostics/vis
