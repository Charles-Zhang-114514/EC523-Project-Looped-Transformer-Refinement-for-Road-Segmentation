#!/bin/bash -l
#$ -N ec523-morph-baseline
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=01:00:00
#$ -m ea
#$ -j y
#$ -o runs/logs/

# Frozen encoder/probe forward: 1669*0.076=127 s. Eight prediction groups
# use about 1669*8*(0.11+0.22)/6=734 s for metrics and shared geometry.
# Morphology, decoding and startup add uncertainty; request one hour.
# 1 loader + 6 spawn workers + main = 8 slots. No refiner is loaded.
source "${SGE_O_WORKDIR:?Submit from repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python -c 'import torch; print("GPU:", torch.cuda.get_device_name(), flush=True)'
git rev-parse HEAD
python -u analysis/morph_baseline.py --device cuda --loader-workers 1 --metric-workers 6 \
    --out-dir results/baselines/morph_y0
