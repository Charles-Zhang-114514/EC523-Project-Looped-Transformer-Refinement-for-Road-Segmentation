#!/bin/bash -l
#$ -N ec523-refiner-v1
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=03:00:00
#$ -m ea
#$ -j y
#$ -o runs/logs/

# Submit from the repository root; create runs/logs before submission.
# GPU encoder: 0.036 s/image * 2522 images * 20 epochs = 30.26 min.
# Final evaluation: encoder 60 s plus six groups of official metrics and
# geometry across six workers, 1669*6*(0.11+0.22)/6=551 s: about 10 min,
# before the unknown refiner forward cost. Seven loaders hide most decoding.
# Do not extrapolate GPU refiner time from the CPU refiner/encoder ratio:
# the encoder uses bf16 tensor cores; the refiner stays fp32 and backpropagates
# through four recurrent steps. Its GPU time and memory remain unmeasured.
# Use h_rt=3 hours: about 30 min encoder + 10 min evaluation + substantial
# allowance for refiner training/inference, monitoring, startup and I/O.
# Training: 7 loaders + main. Monitor/final eval: 1 loader + 6 workers + main.
# Loaders exit after each epoch so training workers do not overlap evaluation.
# Trailing arguments are forwarded for --resume or --eval-only/--ckpt recovery.
source "${SGE_O_WORKDIR:?Submit from the repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
: "${EC523_DATA_DIR:?Set EC523_DATA_DIR in env.sh}"
: "${EC523_STARTER_DIR:?Set EC523_STARTER_DIR in env.sh}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

python -c 'import torch, numpy, transformers; print("GPU:", torch.cuda.get_device_name(), flush=True); print("Versions:", {"torch": torch.__version__, "numpy": numpy.__version__, "transformers": transformers.__version__}, flush=True)'
git rev-parse HEAD

python -u scripts/train_refiner.py \
    --epochs 20 --batch-size 4 --lr 3e-4 --k-train 4 --eval-k 1,2,4,6,8 \
    --device cuda --seed 0 --loader-workers 7 --eval-loader-workers 1 --metric-workers 6 \
    --monitor-every 5 --monitor-per-domain 50 \
    --out-dir results/refiner/v1 --ckpt-dir runs/refiner/v1/checkpoints "$@"
