#!/bin/bash -l
#$ -N ec523-probe-protocol
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l h_rt=08:00:00
#$ -l mem_per_core=8G
#$ -j y
#$ -o runs/logs/

# Submit from the repository root. Eval uses 1 loader + 6 metric workers + main;
# training uses 7 loader workers + main. Decode estimate: each trained setting
# reads 2,522*10 images, adding 2,522*10*0.05/7 = 180 seconds. Metric estimate:
# each Val pass scores 1,669*19 image-threshold pairs, adding 1,669*19*0.11/6 =
# 580 seconds; across four runs that is 2,320 seconds (39 minutes). The earlier
# GPU pilot projected 2.8 hours per trained setting including model compute and
# the three-threshold validation; the 180-second decode estimate is included in
# that training wall estimate. Replacing its 92-second metric estimate per trained
# run with 4 full-grid validations (2,320 seconds total) gives about 6h12m.
# h_rt=8h leaves startup and throughput margin.
source "${SGE_O_WORKDIR:?Submit from the repository root}/scripts/activate_scc.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
: "${EC523_DATA_DIR:?Set EC523_DATA_DIR in the optional env.sh override}"
: "${EC523_STARTER_DIR:?Set EC523_STARTER_DIR in the optional env.sh override}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

echo "=== GPU ==="
nvidia-smi
echo "=== Python ==="
which python
python - <<'PY'
import importlib.metadata as md
import torch
import torchvision
for package in ("numpy", "scipy", "scikit-image", "Pillow", "safetensors"):
    print(f"{package}=={md.version(package)}")
print(f"torch=={torch.__version__}")
print(f"torchvision=={torchvision.__version__}")
PY

python scripts/train_linear_probe.py --encoder resnet50_layer3 --batch-size 8 --lr 1e-3 \
    --seed 0 --device cuda --eval-only --ckpt runs/linear_probe/checkpoints/posw_auto.pt \
    --metric-workers 6 --eval-loader-workers 1 --loader-workers 7 \
    --out-dir results/linear_probe/resnet50_layer3_protocol/posw_auto

python scripts/train_linear_probe.py --encoder resnet50_layer3 --batch-size 8 --lr 1e-3 \
    --seed 0 --device cuda --eval-only --ckpt runs/linear_probe/checkpoints/posw_1.pt \
    --metric-workers 6 --eval-loader-workers 1 --loader-workers 7 \
    --out-dir results/linear_probe/resnet50_layer3_protocol/posw_1

python scripts/train_linear_probe.py --encoder resnet50_layer3 --epochs 10 --batch-size 8 --lr 1e-3 \
    --pos-weight 2 --seed 0 --device cuda --loader-workers 7 \
    --eval-loader-workers 1 --metric-workers 6 \
    --out-dir results/linear_probe/resnet50_layer3_protocol/posw_2

python scripts/train_linear_probe.py --encoder resnet50_layer3 --epochs 10 --batch-size 8 --lr 1e-3 \
    --pos-weight 4 --seed 0 --device cuda --loader-workers 7 \
    --eval-loader-workers 1 --metric-workers 6 \
    --out-dir results/linear_probe/resnet50_layer3_protocol/posw_4
