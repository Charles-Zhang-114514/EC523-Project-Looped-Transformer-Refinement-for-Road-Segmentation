#!/bin/bash -l
#$ -N ec523-b-refiner
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=02:00:00
#$ -m ea
#$ -j y
#$ -o runs/logs/

# Submit from the repository root after mkdir -p runs/logs.
# e6 L40S walltime was ~45 min. e7/e9 retain the same loop depth/workload.
# e8 has E[K]=4, so expected work remains near e6, but K=6 batches have
# up to 6/4=1.5 times the refiner work/retained activations. Conservatively
# scaling the entire walltime gives 67.5 min; 50% margin gives 101.25 min,
# within 120 min. Encoder and evaluation work actually remain unchanged.
# Activation-only scaling suggests ~1.5x the e6 6.17 GiB training peak;
# allocator/workspace effects are uncertain and actual peaks are recorded.
# Main + seven Train loaders; eval main + one loader + six metric workers.
set -euo pipefail
if [[ $# != 2 ]]; then
    echo 'Usage: qsub jobs/b_refiner_variants.qsub e7|e8|e9 0|1|2' >&2
    exit 2
fi
case "$1" in
    e7) EXPERIMENT=e7_stepw; VARIANT_ARGS=(--step-weights 0.1,0.2,0.3,0.4) ;;
    e8) EXPERIMENT=e8_randk; VARIANT_ARGS=(--k-train-choices 2,3,4,5,6) ;;
    e9) EXPERIMENT=e9_posw2; VARIANT_ARGS=(--pos-weight 2) ;;
    *) echo 'Variant must be exactly e7, e8 or e9.' >&2; exit 2 ;;
esac
case "$2" in
    0|1|2) SEED="$2" ;;
    *) echo 'Seed must be exactly 0, 1 or 2.' >&2; exit 2 ;;
esac
source "${SGE_O_WORKDIR:?Submit from repository root}/env.sh"
cd "$SGE_O_WORKDIR"
export PYTHONPATH="$PWD/src:$PWD"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
python - <<'PY'
import torch, numpy, transformers
print('GPU:', torch.cuda.get_device_name(), flush=True)
print('Versions:', torch.__version__, numpy.__version__, transformers.__version__, flush=True)
PY
git rev-parse HEAD
OUT_DIR="results/exp/${EXPERIMENT}_s${SEED}"
CKPT_DIR="runs/exp/${EXPERIMENT}_s${SEED}"
python -u scripts/train_refiner.py \
    --head-type conv_upsample --epochs 10 --batch-size 4 --lr 3e-4 \
    --k-train 4 --seed "$SEED" --device cuda \
    --select-every 1 --select-per-domain 100 \
    --selection-ks 1:0.25,2:0.25,4:0.5 \
    --val-split configs/val_split_seed0.json --eval-extra --eval-k 1,2,4,6,8 \
    --probe-ckpt runs/draft_head/A1-i/best.pt \
    --out-dir "$OUT_DIR" --ckpt-dir "$CKPT_DIR" "${VARIANT_ARGS[@]}"
python - "$OUT_DIR/metrics.json" <<'PY'
import json, math, sys
with open(sys.argv[1]) as handle:
    report = json.load(handle)
actual = report['evaluation']['groups']['Overall']['y0_draft']['scores']['A']
reference = 0.538246
difference = actual - reference
passed = math.isfinite(actual) and abs(difference) <= 1e-5
print(f"{'PASS' if passed else 'FAIL'} B y0_draft Overall_A={actual:.12f} "
      f"reference={reference:.12f} delta={difference:+.12g} tolerance=1e-5", flush=True)
PY
