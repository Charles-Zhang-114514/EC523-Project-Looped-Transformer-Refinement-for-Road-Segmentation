#!/bin/bash -l
#$ -N ec523-lora-smoke
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=00:30:00
#$ -j y
#$ -m ea
#$ -o runs/logs/

# Resource measurement only. L0 before updates; 20 updates each at batch 2 and 4.
source "${SGE_O_WORKDIR:?Submit from the repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
export PYTHONPATH="$PWD:$PWD/src"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
python - <<'PYINFO'
import sys, torch
from importlib.metadata import version
print("GPU:", torch.cuda.get_device_name(), flush=True)
print("Python:", sys.version.split()[0], flush=True)
for name in ("torch", "numpy", "scipy", "Pillow", "transformers", "safetensors"):
    print(name, version(name), flush=True)
PYINFO
git rev-parse HEAD

python -u scripts/train_lora_draft.py --smoke --out-dir runs/wave1/lora_smoke
