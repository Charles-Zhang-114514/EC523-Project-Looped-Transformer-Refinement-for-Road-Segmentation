#!/bin/bash -l
#$ -N ec523-failure-analysis
#$ -P ec523kb
#$ -cwd
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l mem_per_core=8G
#$ -l h_rt=01:30:00
#$ -m ea
#$ -j y
#$ -o runs/logs/

# Submit from repository root after mkdir -p runs/logs.
# Two sets * 835: encoding 2*120=240 s. Three model seeds per set:
# refinement 2*3*106=636 s, metrics 2*3*835*5*.125/6=521.9 s,
# geometry 2*3*835*5*.22/6=918.5 s. Sum 2316.4 s (~38.6 min).
# Allow 20 min for cache/model I/O, merge classification, independent
# Counts checks, spawn and selected PNG panels; request 90 min.
# One live float32 feature cache ~13.1 GiB; require 32 GiB free.
# Packed seed-0 y0/K4 masks remain in RAM (~418 MiB for both sets),
# never on disk. No saved feature/probability/answer artifacts remain.
NODE_TMP="${TMPDIR:?Node-local scratch is required}"
source "${SGE_O_WORKDIR:?Submit from repository root}/env.sh" || exit 1
set -euo pipefail
cd "$SGE_O_WORKDIR"
export TMPDIR="$NODE_TMP" TMP="$NODE_TMP" TEMP="$NODE_TMP"
export PYTHONPATH="$PWD/src:$PWD"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
FAILURE_CACHE_ROOT="$(mktemp -d "$TMPDIR/ec523-failure-${JOB_ID:-manual}-XXXXXX")"
trap 'rm -rf -- "$FAILURE_CACHE_ROOT"' EXIT
python - <<'PY'
import os, shutil, torch, numpy, transformers
print('GPU:',torch.cuda.get_device_name(),flush=True)
print('Versions:',torch.__version__,numpy.__version__,transformers.__version__,flush=True)
free=shutil.disk_usage(os.environ['TMPDIR']).free
print('TMPDIR free bytes:',free,flush=True)
if free<32*1024**3: raise RuntimeError('Need at least 32 GiB free node scratch')
PY
git rev-parse HEAD
python -u analysis/failure_analysis.py --device cuda --loader-workers 1 --metric-workers 6 \
    --cache-dir "$FAILURE_CACHE_ROOT" --out-dir results/failure --vis-dir runs/failure_vis
